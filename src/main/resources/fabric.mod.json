{
	"schemaVersion": 1,
	"id": "nocturne",
	"version": "${version}",
	"name": "Nocturne",
	"description": "Nocturne is a lightweight black-and-gray utility client: HUD counters, Fullbright, Zoom, dashboard GUI, themes and profiles.",
	"authors": [
		"Nocturne"
	],
	"license": "MIT",
	"icon": "assets/nocturne/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.nocturne.client.NocturneClient"
		]
	},
	"mixins": [
		"nocturne.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
